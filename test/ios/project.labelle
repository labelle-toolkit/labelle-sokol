.{
    .name = "sokol_ios_fixture", .title = "Sokol iOS Fixture",
    .width = 800, .height = 600, .target_fps = 60,
    .backend = .sokol,
    .backend_package = .{ .name = "sokol", .repo = "local:../.." },
    .gamepad = .none, .ecs = .mock, .y_axis = .up,
    .initial_prefab = "main", .states = .{"playing"},
    .layers = .{ .{ .name = "hud", .order = 0, .space = .screen } },
    .core_version = "2.1.0", .engine_version = "3.4.1", .gfx_version = "2.2.0",
    .assembler_version = "0.117.1",
}
